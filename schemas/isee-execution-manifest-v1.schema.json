{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asrp.dev/schema/isee-execution-manifest-v1.schema.json",
  "title": "ISEE Execution Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "manifest_id", "compiled_at", "scope", "intent_bindings",
    "structure_bindings", "entry_point", "elements", "gates",
    "evidence_requirements", "artifacts", "integrity"
  ],
  "properties": {
    "schema_version": { "const": "isee-execution-manifest/v1" },
    "manifest_id": { "type": "string", "format": "uuid" },
    "compiled_at": { "type": "string", "format": "date-time" },
    "scope": { "type": "string", "minLength": 1 },
    "intent_bindings": { "type": "array", "items": { "type": "object" } },
    "structure_bindings": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "entry_point": { "type": "object" },
    "elements": { "type": "array", "items": { "type": "object" } },
    "gates": { "type": "array", "items": { "type": "object" } },
    "evidence_requirements": { "type": "array", "items": { "type": "object" } },
    "artifacts": { "type": "array", "items": { "type": "object" } },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_fingerprint"],
      "properties": {
        "manifest_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
